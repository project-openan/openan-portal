      "task": "task-live-002",
      "short": {
        "zh": "策略生成",
        "en": "Policy"
      }
    },
    {
      "id": "step3",
      "name": {
        "zh": "功率提升与节能 SLA 冲突协商",
        "en": "Power Boost & Energy SLA Negotiation"
      },
      "agent": "ran",
      "skill": "Network Policy Execution",
      "task": "task-live-003",
      "short": {
        "zh": "功率协商",
        "en": "Negotiate"
