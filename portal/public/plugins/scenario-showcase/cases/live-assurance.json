{
  "$schema": "scenario-showcase-case-v1",
  "id": "live-assurance",
  "title": {
    "zh": "大型赛事直播业务保障",
    "en": "Major-event Live Broadcast Assurance"
  },
  "description": {
    "zh": "城市马拉松赛事直播保障闭环：业务保障智能体生成策略，无线域智能体执行功率提升时发现节能 SLA 冲突并经 A2A-T 协商裁定；KQI 劣化后关闭全部节能并跨站协同优化，恢复后回归初始配置。",
    "en": "City-marathon live broadcast assurance closed loop: the Assurance Agent generates the policy, the RAN Agent discovers an energy-saving SLA conflict during power boost and resolves it via A2A-T negotiation; KQI degradation triggers a full energy-saving shutdown with inter-site coordination, and the initial configuration is restored after recovery."
  },
  "agents": [
    {
      "id": "crm",
      "name": {
        "zh": "CRM智能体",
        "en": "CRM Agent"
      },
      "role": "crm",
      "color": "rose",
      "skills": [
        "Customer Intent Parsing",
        "Assurance Team Assembly"
      ]
    },
    {
      "id": "live-streaming",
      "name": {
        "zh": "直播域智能体",
        "en": "Live Streaming Agent"
      },
      "role": "host",
      "color": "blue",
      "skills": [
        "Event Info Parsing",
        "KQI Monitoring"
      ]
    },
    {
      "id": "assurance",
      "name": {
        "zh": "业务保障智能体",
        "en": "Assurance Agent"
      },
      "role": "domain",
      "color": "amber",
      "skills": [
        "Policy Generation",
        "Recovery Policy Dispatch"
      ]
    },
    {
      "id": "ran",
      "name": {
        "zh": "无线域智能体",
        "en": "RAN Agent"
      },
      "role": "domain",
      "color": "emerald",
      "skills": [
        "Network Policy Execution",
        "Energy SLA Negotiation"
      ]
    }
  ],
  "steps": [
    {
      "id": "crm-intent",
      "name": {
        "zh": "接收客户意图",
        "en": "Receive Customer Intent"
      },
      "agent": "crm",
      "skill": "Customer Intent Parsing",
      "task": "REQ-2026-1102"
    },
    {
      "id": "crm-assembly",
      "name": {
        "zh": "组建保障团队",
        "en": "Assemble Assurance Team"
      },
      "agent": "crm",
      "skill": "Assurance Team Assembly",
      "task": "REQ-2026-1102",
      "next": [
        "live-streaming",
        "assurance",
        "ran"
      ]
    },
    {
      "id": "step1",
      "name": {
        "zh": "赛事信息解析与保障订阅",
        "en": "Event Info Parsing & Subscription"
      },
      "agent": "live-streaming",
      "type": "selfloop",
      "skill": "Event Info Parsing",
      "task": "task-live-001",
      "short": {
        "zh": "解析订阅",
        "en": "Subscribe"
      }
    },
    {
      "id": "step2",
      "name": {
        "zh": "保障策略生成",
